# Build context allow-list (DEP-09): the image needs only these (see Dockerfile).
# Everything else (docs, tests, tools, node_modules, data, agent/cache folders)
# stays out of the context. tests/test_repo_hygiene_and_docker.py checks that
# every Dockerfile COPY source is listed here.
*
!src/
!web/
!run.py
!run_server.py
!driver.json
!requirements.txt
!requirements-uc.txt
!LICENSE
!THIRD_PARTY_NOTICES.md
!LICENSES/

# Never ship caches, packaging output or local state from inside the allowed
# folders (BE-27 leftovers such as src/driver.lock, src/config_state.json and
# src/*.egg-info appear in working checkouts).
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/*.egg-info/
**/*.lock
**/config_state.json
**/node_modules/
**/*.log

# Secrets and editor/OS clutter.
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.swp
**/*~
**/.DS_Store
**/Thumbs.db

# Binaries and captures the repository guard also rejects (tools/check_repo_hygiene.py).
**/*.bin
**/*.exe
**/*.c4z
**/*.har
