# Build context allow-list: the image needs only these (see Dockerfile).
# Everything else (docs, tests, tools, node_modules, data, agent/cache folders)
# stays out of the context.
*
!src/
!web/
!run.py
!run_server.py
!driver.json
!requirements.txt
!requirements-uc.txt

# Never ship caches or local state from inside the allowed folders.
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/*.lock
**/config_state.json
