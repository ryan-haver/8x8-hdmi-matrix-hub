  "procedure": [
    "reset the simulator to the seed state",
    "let the hub read the matrix (/ws get_status), so it is in sync before the action",
    "setup (api): request(method='PUT', path='/api/v2/scenes/scene_goodnight01', json={'steps': [], 'overrides': {}}) -> HTTP 200",
    "action (browser): scene_wait_edit(scene_id='scene_goodnight01', seconds=0.5, steps=[{'type': 'wait', 'id': '', 'params': {'seconds': 0.5}}])",
    "  open /ui and wait until the app has loaded its data",
    "  answer the prompt \"Wait duration in seconds (0.5–30):\" with the passcode",
    "  edit scene_goodnight01, add a 0.5-second wait through the duration prompt",
    "  answer the prompt \"Wait duration in seconds (0.5–30):\" with the passcode",
    "  add a second wait, remove the first, and verify exactly one step remains after rerendering",
    "  save the scene through the editor",
    "  the page sent PUT /api/v2/scenes/scene_goodnight01 -> HTTP 200",
    "  the page shows: success: Scene updated",
    "cleanup (api): request(method='PUT', path='/api/v2/scenes/scene_goodnight01', json={'name': 'Good Night', 'steps': [{'type': 'system_action', 'id': 'mute_all_audio'}, {'type': 'macro', 'id': 'macro_all_off'}], 'overrides': {}}) -> HTTP 200"
