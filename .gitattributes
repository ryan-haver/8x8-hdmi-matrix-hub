# Git hooks and shell scripts must keep LF line endings, even in Windows
# checkouts with core.autocrlf=true; otherwise sh fails on the trailing \r.
.githooks/* text eol=lf
*.sh text eol=lf

# Third-party notices retain the exact bytes shipped by their distributions.
LICENSES/python/** -text

# Hash-indexed runtime evidence must retain the original Linux/Windows bytes.
# Scope the records to this campaign so historical evidence is not renormalized.
docs/validation/runs/runtime/** -text
docs/validation/evidence/**/2026-10-19-*-4adbc136-*.json -text

# UI visual baselines (docs/REMEDIATION_PLAN.md §5.3) are stored in Git LFS.
# The LFS hooks are in .githooks/ because core.hooksPath points there.
tests/e2e/visual/**/*.png filter=lfs diff=lfs merge=lfs -text
docs/validation/evidence/**/*.png filter=lfs diff=lfs merge=lfs -text
