#!/bin/sh
# Pre-commit hook: ruff lint + fast unit tests before every commit.
# Stored in .githooks/ and activated via: git config core.hooksPath .githooks
#
# Mirrors the CI `lint` and `test` jobs (.github/workflows/ci.yml) so problems
# are caught locally. Fails loudly if a required tool is missing rather than
# silently skipping the check. POSIX sh: works in Git Bash on Windows and on
# Linux/macOS.

fail() {
    echo "" >&2
    echo "pre-commit: FAILED - $1" >&2
    shift
    for line in "$@"; do
        echo "  $line" >&2
    done
    exit 1
}

# Locate a tool: this checkout's .venv, then the main checkout's .venv (when
# committing from a linked worktree), then PATH. Prints the command or nothing.
find_tool() {
    name="$1"
    common_dir=$(git rev-parse --git-common-dir 2>/dev/null)
    main_root=""
    if [ -n "$common_dir" ]; then
        main_root=$(cd "$common_dir/.." 2>/dev/null && pwd)
    fi
    for venv in ".venv" "$main_root/.venv"; do
        [ -n "$venv" ] || continue
        if [ -f "$venv/Scripts/$name.exe" ]; then
            echo "$venv/Scripts/$name.exe"
            return 0
        fi
        if [ -x "$venv/bin/$name" ]; then
            echo "$venv/bin/$name"
            return 0
        fi
    done
    if command -v "$name" >/dev/null 2>&1; then
        echo "$name"
        return 0
    fi
    return 1
}

RUFF=$(find_tool ruff) || fail "ruff not found in .venv or PATH." \
    "Install the dev tools: pip install -e \".[dev]\""
PYTEST=$(find_tool pytest) || fail "pytest not found in .venv or PATH." \
    "Install the dev tools: pip install -e \".[dev]\""

# --- Lint (same paths as CI; only those that exist) --------------------------
LINT_PATHS=""
for p in src tests custom_components tools run.py run_server.py; do
    if [ -e "$p" ]; then
        LINT_PATHS="$LINT_PATHS $p"
    fi
done

echo "pre-commit: ruff check$LINT_PATHS"
# shellcheck disable=SC2086
if ! "$RUFF" check $LINT_PATHS; then
    fail "ruff lint errors (see above)." \
        "Auto-fix what can be fixed with: $RUFF check$LINT_PATHS --fix"
fi

# --- Fast unit tests (never talks to real hardware) --------------------------
USE_MOCK_MATRIX="${USE_MOCK_MATRIX:-1}"
export USE_MOCK_MATRIX

# tests/uc (the scripted-Remote harness, ~5 min: every test starts the real
# driver) is its own CI job, like here; run it with: pytest tests/uc
echo "pre-commit: pytest (stop on first failure)"
if ! "$PYTEST" tests/ --ignore=tests/ha --ignore=tests/uc -q -x -p no:cacheprovider; then
    fail "pytest failures (see above)." \
        "Re-run with: $PYTEST tests/ --ignore=tests/ha --ignore=tests/uc -x"
fi

echo "pre-commit: OK (ruff + pytest passed)"
